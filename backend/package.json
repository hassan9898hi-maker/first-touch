{
  "name": "first-touch-backend",
  "version": "2.0.0",
  "description": "FIRST TOUCH — Construction Project Management Backend",
  "main": "src/server.js",
  "scripts": {
    "start": "node start.js",
    "dev": "node src/server.js",
    "seed": "node prisma/seed.js",
    "setup": "npm install && npx prisma generate && npx prisma db push && node prisma/seed.js",
    "setup:prod": "npx prisma generate && npx prisma migrate deploy",
    "db:push": "npx prisma db push",
    "db:migrate": "npx prisma migrate dev",
    "db:migrate:deploy": "npx prisma migrate deploy",
    "db:generate": "npx prisma generate",
    "db:studio": "npx prisma studio",
    "db:reset": "npx prisma db push --force-reset && node prisma/seed.js",
    "build": "node scripts/prisma-generate.js",
    "postinstall": "node scripts/prisma-generate.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "@prisma/client": "^6.7.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.9.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.0",
    "socket.io": "^4.8.0",
    "uuid": "^11.1.0",
    "winston": "^3.17.0",
    "zod": "^3.24.0"
  },
  "optionalDependencies": {
    "twilio": "^5.12.2"
  },
  "devDependencies": {
    "prisma": "^6.7.0"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
